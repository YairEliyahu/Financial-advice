# Neon connection string. sslmode=require is expected.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

PORT=4000
HOST=0.0.0.0
FRONTEND_ORIGIN=http://localhost:3000

# Seeded advisor. No open registration. Phone is digits, optional leading +.
PILOT_PHONE=0500000000
PILOT_PASSWORD=change-me-please

# 32 bytes, base64. Generate with:
# node --input-type=module -e "import { randomBytes } from 'node:crypto'; console.log(randomBytes(32).toString('base64'))"
ID_ENCRYPTION_KEY=

# Long-lived session cookie. Use COOKIE_SECURE=true and COOKIE_SAMESITE=none on HTTPS.
SESSION_TTL_DAYS=365
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
